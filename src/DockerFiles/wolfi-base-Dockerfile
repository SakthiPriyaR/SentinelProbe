############################
# Builder Stage
############################
# use chainguard hardened images with SBOM
FROM cgr.dev/chainguard/wolfi-base AS builder

WORKDIR /sentinelprobe

ARG version=3.12

ENV LANG=C.UTF-8
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/sentinelprobe/.venv/bin:$PATH"


RUN apk add python-${version} py${version}-pip && \
        chown -R nonroot:nonroot /sentinelprobe

# install the package (and API extras) into a virtualenv with pip.
# (poetry.lock is not used here, so a stale lock can't break the image build)
COPY pyproject.toml README.md ./
COPY sentinelprobe ./sentinelprobe
RUN python -m venv /sentinelprobe/.venv && \
        /sentinelprobe/.venv/bin/pip install --no-cache-dir ".[api]"

############################
# runtime stage
############################
FROM cgr.dev/chainguard/wolfi-base AS runtime

WORKDIR /sentinelprobe

ARG version=3.12

ENV LANG=C.UTF-8
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/sentinelprobe/.venv/bin:$PATH"
ENV VIRTUAL_ENV=/sentinelprobe/.venv

RUN apk add python-${version} py${version}-pip && \
	    chown -R nonroot:nonroot /sentinelprobe


# copy venv from builder image
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}

# copy necessary files
COPY sentinelprobe ./sentinelprobe
COPY README.md CODE_OF_CONDUCT.md DISCLAIMER.md dashboard.html pyproject.toml ./

USER nonroot
